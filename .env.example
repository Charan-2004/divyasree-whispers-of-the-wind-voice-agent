PORT=3050
NODE_ENV=development

# LiveKit Cloud Configuration
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=your_livekit_api_key
LIVEKIT_API_SECRET=your_livekit_api_secret

# Gemini API Configuration
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-3.1-flash-lite

# Sarvam AI Configuration
SARVAM_API_KEY=your_sarvam_api_key
SARVAM_BACKUP_API_KEY=your_backup_key
SARVAM_STT_MODEL=saaras:v3
SARVAM_TTS_MODEL=bulbul:v3
SARVAM_DEFAULT_SPEAKER=shubh

# Silence & Cost Guard Limits
SILENCE_TIMEOUT_1_SECONDS=14
SILENCE_TIMEOUT_2_SECONDS=14
MAX_CALL_DURATION_SECONDS=180
MAX_TURNS_PER_CALL=20
MAX_TTS_CHARACTERS_PER_CALL=3500
MAX_STT_SECONDS_PER_CALL=180
